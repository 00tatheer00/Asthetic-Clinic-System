# ============================================================
# Brimish Skin Care Clinic — Environment Variables Configuration
# ============================================================

# ------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage)
# ------------------------------------------------------------
# [PUBLIC] The base URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# [PUBLIC] The anonymous public API key with Row-Level Security enforced
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# [SECRET - SERVER ONLY] Service role key (bypasses RLS). NEVER expose to client/browser!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------
# 2. Resend (Transactional Email)
# ------------------------------------------------------------
# [SECRET - SERVER ONLY] Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# [SERVER ONLY] Verified sender address (must match domain verified in Resend)
RESEND_FROM_EMAIL=Brimish Skin Care <noreply@brimishskincare.com>

# ------------------------------------------------------------
# 3. Application & Clinic Notifications
# ------------------------------------------------------------
# [PUBLIC] The canonical production URL of the deployed web application (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://brimishskincare.com

# [SERVER ONLY] Clinic management inbox receiving booking notifications & low-stock alerts
CLINIC_ADMIN_EMAIL=admin@brimishskincare.com

# ------------------------------------------------------------
# 4. Cron & Automated Job Authentication
# ------------------------------------------------------------
# [SECRET - SERVER ONLY] Bearer secret required in Authorization header for /api/cron/*
CRON_SECRET=your_super_secret_cron_key_min_32_chars
